AUTH_MODE=demo
AUTH_STORAGE_MODE=sqlite
AUTH_SQLITE_PATH=/data/auth-demo.sqlite
AUTH_POSTGRES_URL=jdbc:postgresql://auth-postgres:5432/kerberos_auth
AUTH_POSTGRES_USER=kerberos_demo
AUTH_POSTGRES_PASSWORD=demo-postgres-password
AUTH_POSTGRES_SSL_MODE=disable
AUTH_SESSION_TTL_SECONDS=300
AUTH_SESSION_MAX_TTL_SECONDS=900
AUTH_SESSION_STORAGE_MODE=sqlite
AUTH_REQUIRE_SESSION_VERIFY=true
AUTH_SECRET_PROVIDER=env
AUTH_AWS_REGION=us-east-1
AUTH_SECRET_CLIENT_SECRET_ID=
AUTH_SECRET_TGS_SECRET_ID=
AUTH_SECRET_SERVICE_SECRET_ID=
AUTH_SECRET_POSTGRES_PASSWORD_ID=
AUTH_WS_HOST=0.0.0.0
AUTH_WS_PORT=2800
AUTH_GATEWAY_HEALTH_PORT=2801
AUTH_AS_HEALTH_PORT=2900
AUTH_TGS_HEALTH_PORT=2901
AUTH_SERVICE_HEALTH_PORT=2902
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
