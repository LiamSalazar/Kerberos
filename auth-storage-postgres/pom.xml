<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.portfolio.auth</groupId>
        <artifactId>auth-monorepo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>auth-storage-postgres</artifactId>
    <name>auth-storage-postgres</name>
    <description>PostgreSQL-backed repositories for cloud/RDS-ready modular auth integration.</description>

    <dependencies>
        <dependency>
            <groupId>com.portfolio.auth</groupId>
            <artifactId>auth-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>postgres-it</id>
            <activation>
                <property>
                    <name>postgres.it</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <auth.postgres.it.enabled>true</auth.postgres.it.enabled>
            </properties>
        </profile>
    </profiles>
</project>
