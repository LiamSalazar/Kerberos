AUTH_MODE=demo
AUTH_STORAGE_MODE=sqlite
AUTH_SQLITE_PATH=/data/auth-demo.sqlite

AUTH_AS_HOST=auth-as
AUTH_AS_PORT=2000
AUTH_TGS_HOST=auth-tgs
AUTH_TGS_PORT=2001
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=2002

AUTH_WS_HOST=0.0.0.0
AUTH_WS_PORT=2800
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

AUTH_SESSION_TTL_SECONDS=300
AUTH_SESSION_MAX_TTL_SECONDS=300
AUTH_SESSION_STORAGE_MODE=sqlite
AUTH_REQUIRE_SESSION_VERIFY=true

# Demo-only secrets. Replace for strict local validation; do not use for production.
AUTH_DEMO_CLIENT_SECRET=ContraseniaCliente
AUTH_DEMO_TGS_SECRET=contraseñaTGS
AUTH_DEMO_SERVICE_SECRET=contraseñaServidor
